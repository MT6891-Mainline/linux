config MTK_COMBO
bool "MediaTek MT6893 connectivity support"
select RTC_LIB
help
  Enable the downstream MediaTek connectivity stack for MT6893
  (CONNAC2X2 SOC3_0) on the chopin mainline port.

config MTK_COMBO_CHIP_CONSYS_6893
bool "MT6893 Consys support"
depends on MTK_COMBO
default y

config MTK_COMBO_WIFI
bool "MT6893 Wi-Fi support"
depends on MTK_COMBO
default y

config MTK_COMBO_BT
bool "MediaTek MT6893 Bluetooth HCI driver"
depends on MTK_COMBO && MTK_BTIF && BT
default y

config MTK_CONNSYS_DEDICATED_LOG_PATH
bool "MTK dedicated connsys log path"
depends on MTK_COMBO
default y
